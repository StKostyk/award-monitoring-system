@startuml C4_Container_As_Built_UA
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Система Моніторингу та Відстеження Нагород - Діаграма Контейнерів, реалізація після епіку 4 (2026-10)

LAYOUT_WITH_LEGEND()

Person(employee, "Працівник", "Подає та відстежує власні нагороди")
Person(reviewer, "Затверджувач", "Секретар Факультету, Декан, Секретар Ректора, Ректор; читає нагороди в межах своєї області")
Person(admin, "Нагляд", "Системний Адміністратор, Офіцер GDPR")

System_Boundary(award_system, "Система Моніторингу та Відстеження Нагород (docker-compose.yaml)") {

    Container(frontend, "Фронтенд", "nginx, Angular 21, NgRx, Angular Material, Transloco", "Віддає односторінковий застосунок (uk, en) і проксіює /api, /oauth2, /connect, /.well-known, /login, /logout до бекенду")

    Container(backend, "Бекенд", "Spring Boot 3.5, Java 21", "Модульний моноліт: вбудований Spring Authorization Server (OAuth 2.1 / OIDC, PKCE, RS256 JWKS), сервер ресурсів /api/v1, користувачі, ролі, делегування, нагороди, категорії, історія версій, статус, документи (завантаження, видача, антивірусна перевірка, квоти), процес рецензування (черга, взяття в роботу, рішення, пакети, виправлення, щогодинне завдання прострочення), спільні й публічні досягнення (анонімний ланцюг /api/v1/public), експорт за GDPR, аудит")

    ContainerDb(postgres, "PostgreSQL", "PostgreSQL 17, Flyway", "Користувачі, підрозділи, ролі, делегування, нагороди, запити, версії, журнали аудиту (партиціоновані), метадані документів, стан сервера авторизації")
    ContainerDb(redis, "Redis", "Redis 7", "Стан безпеки: моменти відкликання токенів, блокування входу й лічильники спроб, обмеження частоти (вхід, завантаження, публічний API), позначки ротованих токенів оновлення")
    ContainerDb(minio, "Об'єктне сховище", "MinIO (S3 API), SSE-S3", "Приватний бакет документів нагород, ключі awards/<award>/<UUID>; бекенд має власний обліковий запис, обмежений цим бакетом")
    Container(clamav, "Антивірусний сканер", "ClamAV clamd, freshclam", "Перевіряє кожне завантаження до збереження; сигнатури оновлюються щодня")
}

System_Ext(smtp, "Поштовий сервер", "Mailpit у розробці: листи підтвердження, скидання, безпеки, ролей, рішень, виправлень і прострочення")

Rel(employee, frontend, "Використовує", "HTTPS")
Rel(reviewer, frontend, "Використовує", "HTTPS")
Rel(admin, frontend, "Використовує", "HTTPS")
Rel(frontend, backend, "Проксіює API та вхід", "HTTP")
Rel(backend, postgres, "Читає/записує", "JDBC")
Rel(backend, redis, "Лічильники, список відкликаних", "RESP")
Rel(backend, smtp, "Надсилає листи", "SMTP")
Rel_D(backend, minio, "Зберігає й передає документи", "S3")
Rel_D(backend, clamav, "Перевіряє завантаження (відмова за замовчуванням)", "clamd INSTREAM, TCP 3310")


note as Planned
  Цільові контейнери, ще не розгорнуті (доповнення до ADR 2026-10):
  брокер повідомлень (ADR-006, епік 7), пошук Elasticsearch (ADR-007, епік 5),
  API-шлюз (ADR-008, замінено nginx), Kubernetes і хмара (ADR-018/020),
  OCR і ШІ-парсинг (функції 3.2, 3.3, відкладено), сервіс сповіщень (епік 7).
  Цільовий вигляд: c4-container.puml
end note

@enduml
