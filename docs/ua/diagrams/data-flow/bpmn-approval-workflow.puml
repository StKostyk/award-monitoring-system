@startuml BPMN_Approval_Workflow_UA
!theme plain

title Робочий Процес Схвалення Нагороди - Діаграма Діяльності

|Власник|
start
:Подати нагороду\n(категорію, організацію, дату вказано);
|Система|
:Відкрити заявку на початковому рівні\n(рівні, де розглядав би лише автор подання, пропускаються);
:Встановити строк рівня;

repeat
    |Рецензент|
    :Відкрити заявку з черги;
    if (Узяв колега?) then (так)
        :Зачекати або взяти на себе з нижчого рівня;
    else (ні)
        :Взяти в роботу або одразу ухвалити рішення\n(рішення бере заявку в роботу);
    endif
    note right
        По одній або пакетом (4.1.4).
        Пропущений строк: щогодинне завдання позначає
        заявку один раз на рівень і сповіщає листом
        наступний рівень із рецензентом (4.2.2).
        Нічого не передається вище само.
    end note
    switch (Рішення?)
    case (Затвердити)
        |Система|
        if (Рівень >= мінімального для категорії?) then (так)
            :Заявка й нагорода APPROVED;\nпозначка перевірки, коли документи перевірено;
            :Лист власникові «затверджено»;
            stop
        else (ні)
            :Заявка ESCALATED на наступний\nнепропущений рівень, новий строк;
            :Лист власникові «передано далі»;
        endif
    case (Передати вище)
        |Система|
        :Заявка ESCALATED на наступний\nнепропущений рівень, новий строк\n(409 no-higher-level у ректора);
        :Лист власникові «передано далі»;
    case (Повернути, коментар)
        |Система|
        :Заявка RETURNED, нагорода DRAFT;
        :Лист власникові з коментарем;
        |Власник|
        :Виправити нагороду й подати повторно (4.1.3);
        |Система|
        :Заявка SUBMITTED на тому самому рівні;
    case (Відхилити, коментар)
        |Система|
        :Заявка й нагорода REJECTED\nіз причиною;
        :Лист власникові з причиною;
        stop
    endswitch
repeat while (Заявка відкрита?) is (так)

stop

@enduml
