@startuml Sequence_Award_Submission_UA
!theme plain
skinparam sequenceMessageAlign center

title Діаграма Послідовності Подання Нагороди (реалізація після епіку 2)

actor "Власник\n(award:create)" as owner
participant "Застосунок Angular" as webapp
participant "nginx" as proxy
participant "AwardController" as ctrl
participant "AwardService /\nAwardSubmission" as svc
participant "AwardInputRules /\nDuplicateFinder" as rules
participant "AwardHistory" as history
participant "AuditService" as audit
database "PostgreSQL" as db

note over webapp, ctrl
    Кожен виклик несе bearer-токен доступу (код авторизації + PKCE);
    сервер ресурсів перевіряє його, а @access.require — дозвіл.
end note

== Створення та редагування чернетки ==
owner -> webapp: Заповнити форму нагороди
webapp -> proxy: POST /api/v1/awards
proxy -> ctrl: переслати
ctrl -> svc: create(form)
svc -> rules: правила полів (дати, URL, активна категорія)
svc -> db: INSERT awards (статус DRAFT, підрозділ власника)
svc -> history: created(award)
history -> db: INSERT award_versions (CREATED, знімок)
svc --> webapp: 201 AwardResponse (id, version)

opt Підказка категорії під час введення
    webapp -> proxy: GET /api/v1/award-categories/suggestions?title=...
    proxy -> ctrl: переслати
    ctrl --> webapp: 200 впорядковані категорії (збіг ключових слів)
end

owner -> webapp: Редагувати чернетку
webapp -> proxy: PUT /api/v1/awards/{id} (форма + version)
proxy -> ctrl: переслати
ctrl -> svc: update(id, form)
svc -> db: UPDATE awards (оптимістичне блокування за version)
svc -> history: updated(award)
history -> db: INSERT award_versions (UPDATED, змінені поля)
svc --> webapp: 200 AwardResponse

== Подання ==
owner -> webapp: Подати
webapp -> proxy: POST /api/v1/awards/{id}/submit {version, acknowledgeDuplicate}
proxy -> ctrl: переслати
ctrl -> svc: submit(id, request)
svc -> db: SELECT ... FOR UPDATE (власна чернетка)
alt не власна чернетка
    svc --> webapp: 404 (чужа) / 409 award-not-editable (уже подана)
else застаріла версія
    svc --> webapp: 409 award-stale {currentVersion}
end
svc -> rules: checkComplete (категорія, організація, що нагороджує, дата нагороди)
alt неповна
    svc --> webapp: 422 validation-failed
end
svc -> rules: збіги дублікатів (та сама дата, подібність назви >= 0.6)
alt є збіги, не підтверджено
    svc --> webapp: 409 award-possible-duplicate {matches}
    webapp --> owner: Показати схожі нагороди, попросити підтвердження
end
svc -> db: UPDATE awards SET status PENDING, impact_score = базовий бал рівня,\norganization = кафедра власника
svc -> history: submitted(award)
history -> db: INSERT award_versions (SUBMITTED)
svc -> db: INSERT award_requests (SUBMITTED, FACULTY_SECRETARY,\nстрок від StatusEstimator)
svc -> audit: AWARD_SUBMITTED {requestId, level, organizationId, duplicateAcknowledged?}
audit -> db: INSERT audit_logs
svc --> webapp: 200 AwardResponse із запитом
webapp --> owner: «Подано на розгляд»

== Відстеження статусу ==
loop кожні 60 с, поки сторінка нагороди відкрита, а запит не остаточний
    webapp -> proxy: GET /api/v1/awards/{id}/status
    proxy -> ctrl: переслати
    ctrl --> webapp: 200 шлях затвердження, строк, очікуване завершення, рішення
end

note over owner, db
    Заплановано: завантаження сертифіката та OCR (епік 3), рішення рецензентів (епік 4),
    сповіщення рецензентам (епік 7).
end note

@enduml
