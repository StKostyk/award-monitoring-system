@startuml Package_Diagram_UA
!theme plain
skinparam package {
    BackgroundColor<<domain>> LightGreen
    BackgroundColor<<security>> LightBlue
    BackgroundColor<<shared>> LightYellow
    BackgroundColor<<config>> LightGray
}

title Система Моніторингу та Відстеження Нагород - Діаграма Пакетів (Java Backend, реалізація після епіку 3)

' Пакети за доменами: кожен домен має controller, dto, entity, event, mapper, repository, service за потреби

package "ua.edu.chnu.awards" {

    package "auth" <<security>> {
        package "web" as auth_web {
            class AuthController
            class LoginController
        }
        package "security" as auth_security {
            class RateLimitFilter
            class JwtAuthorityConverter
            class RefreshTokenReuseGuard
            class LoginAttemptService
        }
        package "service" as auth_service {
            class RegistrationService
            class PasswordResetService
            class EmailChangeService
            class DeviceService
        }
        package "entity" as auth_entity {
            class OneTimeToken
            class UserDevice
        }
    }

    package "authz" <<security>> {
        class AccessScope
        class OrganizationTree
        class RoleScope
        class DelegatedScope
        class AccessDenials
    }

    package "user" <<domain>> {
        package "controller" as user_controller {
            class UserController
            class UserProfileController
            class OrganizationController
        }
        package "service" as user_service {
            class UserDirectoryService
            class UserProfileService
            class RoleAssignmentService
            class OrganizationService
        }
        package "entity" as user_entity {
            class User
            class UserRole
            class Organization
        }
    }

    package "delegation" <<domain>> {
        class DelegationController
        class DelegationService
        class RoleDelegation
    }

    package "award" <<domain>> {
        package "controller" as award_controller {
            class AwardController
            class AwardCategoryController
            class AwardHistoryController
        }
        package "service" as award_service {
            class AwardService
            class AwardSubmission
            class AwardOwnership
            class AwardInputRules
            class DuplicateFinder
            class CategorySuggester
            class AwardHistory
            class AwardStatusService
            class StatusEstimator
        }
        package "entity" as award_entity {
            class Award
            class AwardCategory
            class AwardRequest
            class ReviewDecision
            class AwardVersion
        }
        package "repository" as award_repository {
            class AwardRepository
            class AwardSpecifications
            class CategorySuggestionQueries
        }
        package "mapper" as award_mapper {
            class AwardMapper
        }
    }

    package "document" <<domain>> {
        package "controller" as document_controller {
            class DocumentController
        }
        package "service" as document_service {
            class DocumentService
            class DocumentUpload
            class UploadLimits
            class MalwareScreening
            class ClamAvScanner
            class ObjectStorage
            class StoredObjectCleanup
            class DocumentSweeper
        }
        package "entity" as document_entity {
            class Document
        }
        package "repository" as document_repository {
            class DocumentRepository
        }
    }

    package "gdpr" <<domain>> {
        class DataExportService
        class PersonalDataAssembler
    }

    package "audit" <<shared>> {
        class AuditService
        class AuditTrailService
        class AuditLog
    }

    package "common" <<shared>> {
        package "web" as common_web {
            class ApiExceptionHandler
            class ApiProblemException
            class CorrelationIdFilter
            class PageResponse
        }
        package "mail" as common_mail {
            class MailDelivery
        }
        package "limit" as common_limit {
            class FixedWindowCounter
        }
    }

    package "metrics" <<shared>> {
        class BusinessMetricsService
    }

    package "config" <<config>> {
        class SecurityConfig
        class AuthorizationServerConfig
        class LoginSessionConfig
        class TokenConfig
        class OpenApiConfig
        class StorageConfig
        class InfrastructureConfig
    }
}

' Залежності між пакетами верхнього рівня
award ..> user : власник, підрозділ
award ..> authz : область читання
award ..> audit : рядки AWARD_*
award ..> document : чернетки видаляються разом з об'єктами
document ..> award : чернетка власника, правило читання
document ..> authz
document ..> audit : рядки DOCUMENT_*
document ..> common
delegation ..> user
delegation ..> authz
user ..> authz
user ..> audit
auth ..> user
auth ..> audit
gdpr ..> user
gdpr ..> award
config ..> auth
config ..> authz
award ..> common
user ..> common

note bottom of award
    Мапери — написані вручну класи @Component;
    без MapStruct. Заплановані домени: parsing (OCR, відкладено),
    workflow (епік 4), analytics (епік 5),
    compliance (епік 6), notification (епік 7).
end note

@enduml
