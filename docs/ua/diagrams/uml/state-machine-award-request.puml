@startuml StateMachine_Award_Request
!theme plain
skinparam state {
    BackgroundColor<<draft>> LightBlue
    BackgroundColor<<pending>> LightYellow
    BackgroundColor<<review>> Orange
    BackgroundColor<<escalated>> LightCoral
    BackgroundColor<<approved>> LightGreen
    BackgroundColor<<rejected>> Pink
    BackgroundColor<<returned>> LightGray
    BackgroundColor<<archived>> DarkGray
}

title Діаграма Скінченного Автомата Запиту на Нагороду

note as AsBuilt
    <b>Таблиця переходів ADR-023 (функція 4.1, §7.2)</b>
    Стани — статуси заявки (<i>award_requests.status</i>);
    статус нагороди (<i>awards.status</i>) вказано в дужках.
    «Рівень» — <i>current_level</i>: FACULTY_SECRETARY, DEAN,
    RECTOR_SECRETARY, RECTOR. Рівень, єдиним рецензентом
    якого був би сам автор подання, пропускається (AC-0.6).
    Рішення ухвалюються в SUBMITTED, ESCALATED або IN_REVIEW;
    заявку, яку ніхто не взяв, рішення бере в роботу саме.
    EXPIRED лишається в обмеженні CHECK, не використовується.
end note

[*] --> DRAFT <<draft>> : Власник створює нагороду

state DRAFT <<draft>> : нагорода DRAFT; редагує, додає документи\nчи видаляє лише власник

DRAFT --> SUBMITTED <<pending>> : подати\n/ початковий рівень (AC-0.6), строк,\nнагорода PENDING

state SUBMITTED <<pending>> : очікує рецензента на рівні
state ESCALATED <<escalated>> : очікує рецензента вищого рівня\nпісля рішення нижче
state IN_REVIEW <<review>> : у роботі в одного рецензента\n(current_reviewer_id)

SUBMITTED --> IN_REVIEW : взяти в роботу
ESCALATED --> IN_REVIEW : взяти в роботу
IN_REVIEW --> SUBMITTED : звільнити\n[нижче рішень не було]
IN_REVIEW --> ESCALATED : звільнити\n[нижчий рівень ухвалив рішення]
IN_REVIEW --> IN_REVIEW : передати колезі, взяти на себе

state "SUBMITTED, ESCALATED, IN_REVIEW" as Open <<review>>
Open --> APPROVED <<approved>> : затвердити\n[рівень >= мінімального для категорії]\n/ нагорода APPROVED
Open --> ESCALATED : затвердити [рівень < мінімального]\nпередати вище [рівень < RECTOR]\n/ наступний непропущений рівень,\nновий строк, рецензента знято
Open --> RETURNED <<returned>> : повернути [коментар]\n/ нагорода DRAFT, рецензента\nі строк знято
Open --> REJECTED <<rejected>> : відхилити [коментар]\n/ rejection_reason, нагорода REJECTED

SUBMITTED --> WITHDRAWN : відкликати [без рецензента]\n/ нагорода DRAFT (4.1.3)
ESCALATED --> WITHDRAWN : відкликати [без рецензента]\n/ нагорода DRAFT (4.1.3)

state RETURNED <<returned>> : нагорода DRAFT; власник виправляє
state WITHDRAWN <<draft>> : нагорода DRAFT; власник відкликав

RETURNED --> SUBMITTED : подати повторно\n/ той самий рівень (або наступний непропущений),\nнагорода PENDING (4.1.3)
WITHDRAWN --> SUBMITTED : подати повторно\n/ початковий рівень, нагорода PENDING (4.1.3)

state APPROVED <<approved>> : остаточний; позначка перевірки, коли\nрецензент перевірив документи
state REJECTED <<rejected>> : остаточний; причину показано власникові

APPROVED --> ARCHIVED <<archived>> : минув строк зберігання (статус нагороди)
REJECTED --> [*]
ARCHIVED --> [*]

legend right
    |= Стан |= Нагорода |= Опис |
    | SUBMITTED | PENDING | Очікує рецензента на початковому рівні |
    | IN_REVIEW | PENDING | У роботі в одного рецензента |
    | ESCALATED | PENDING | Очікує рецензента вищого рівня |
    | RETURNED | DRAFT | Повернуто на доопрацювання |
    | WITHDRAWN | DRAFT | Відкликано власником до взяття в роботу |
    | APPROVED | APPROVED | Остаточний |
    | REJECTED | REJECTED | Остаточний |
endlegend

@enduml
