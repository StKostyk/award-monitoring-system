@startuml Class_Diagram_Domain_UA
!theme plain
skinparam classAttributeIconSize 0
skinparam linetype ortho

title Система Моніторингу та Відстеження Нагород - Діаграма Класів Домену (реалізація після епіку 2)

' Сутності JPA пакета ua.edu.chnu.awards; класи з позначкою <<planned>> існують лише як таблиці

package "user" <<Rectangle>> {

    class User {
        -id: Long
        -emailAddress: String
        -firstName: String
        -lastName: String
        -passwordHash: String
        -accountStatus: AccountStatus
        -organization: Organization
        -lastLoginAt: Instant
        -createdAt: Instant
        -updatedAt: Instant
        -version: Long
        +isActive(): boolean
    }

    enum AccountStatus {
        PENDING
        ACTIVE
        INACTIVE
        SUSPENDED
        RETIRED
        MEMORIAL
        DELETED
    }

    class UserRole {
        -id: Long
        -user: User
        -roleType: RoleType
        -organization: Organization
        -validFrom: LocalDate
        -validTo: LocalDate
        -createdAt: Instant
        -createdBy: User
        +isCurrentOn(day: LocalDate): boolean
        +hasEndedBy(day: LocalDate): boolean
    }

    enum RoleType {
        EMPLOYEE
        FACULTY_SECRETARY
        DEAN
        RECTOR_SECRETARY
        RECTOR
        SYSTEM_ADMIN
        GDPR_OFFICER
    }

    class Organization {
        -id: Long
        -name: String
        -nameUk: String
        -code: String
        -orgType: OrganizationType
        -parent: Organization
        -depth: int
        -active: boolean
        +enclosingFaculty(): Organization
    }

    enum OrganizationType {
        UNIVERSITY
        COLLEGE
        FACULTY
        SPECIALITY
        DEPARTMENT
    }
}

package "delegation" <<Rectangle>> {

    class RoleDelegation {
        -id: Long
        -delegator: User
        -delegate: User
        -roleType: RoleType
        -organization: Organization
        -validFrom: LocalDate
        -validTo: LocalDate
        -reason: String
        -revokedAt: Instant
        -revokedBy: User
        +stateOn(day: LocalDate): DelegationState
        +isCurrentOn(day: LocalDate): boolean
    }

    enum DelegationState {
        ACTIVE
        UPCOMING
        EXPIRED
        REVOKED
    }
}

package "award" <<Rectangle>> {

    class Award {
        -id: Long
        -owner: User
        -organization: Organization
        -category: AwardCategory
        -title: String
        -titleUk: String
        -description: String
        -descriptionUk: String
        -awardingOrganization: String
        -awardDate: LocalDate
        -status: AwardStatus
        -verificationBadge: boolean
        -impactScore: Integer
        -externalUrl: String
        -createdAt: Instant
        -updatedAt: Instant
        -version: Long
        +isDraft(): boolean
    }

    enum AwardStatus {
        DRAFT
        PENDING
        APPROVED
        REJECTED
        ARCHIVED
    }

    class AwardCategory {
        -id: Long
        -name: String
        -nameUk: String
        -description: String
        -level: RecognitionLevel
        -parent: AwardCategory
        -sortOrder: int
        -active: boolean
        -system: boolean
    }

    enum RecognitionLevel {
        SPECIALITY (FACULTY_SECRETARY, 10)
        DEPARTMENT (FACULTY_SECRETARY, 20)
        COLLEGE (DEAN, 30)
        FACULTY (DEAN, 40)
        LOCAL (FACULTY_SECRETARY, 45)
        UNIVERSITY (FACULTY_SECRETARY, 60)
        REGIONAL (FACULTY_SECRETARY, 70)
        NATIONAL (RECTOR_SECRETARY, 80)
        INTERNATIONAL (RECTOR_SECRETARY, 100)
        --
        +minimumApproval(): ApprovalLevel
        +baseScore(): int
    }

    class AwardVersion <<immutable>> {
        -id: Long
        -awardId: Long
        -number: long
        -action: VersionAction
        -actor: User
        -snapshot: AwardSnapshot
        -changedFields: String[]
        -createdAt: Instant
    }

    enum VersionAction {
        BASELINE
        CREATED
        UPDATED
        SUBMITTED
    }

    class AwardSnapshot <<record>> {
        title, titleUk, description, descriptionUk
        awardingOrganization, awardDate, categoryId
        status, impactScore, verificationBadge
        externalUrl, organizationId
    }

    class AwardRequest {
        -id: Long
        -award: Award
        -submitter: User
        -status: RequestStatus
        -currentLevel: ApprovalLevel
        -submittedAt: Instant
        -deadline: Instant
        -completedAt: Instant
        -rejectionReason: String
    }

    enum RequestStatus {
        SUBMITTED
        IN_REVIEW
        ESCALATED
        APPROVED
        REJECTED
        RETURNED
        EXPIRED
    }

    enum ApprovalLevel {
        FACULTY_SECRETARY
        DEAN
        RECTOR_SECRETARY
        RECTOR
    }

    class ReviewDecision <<immutable>> {
        -id: Long
        -requestId: Long
        -reviewer: User
        -decision: ReviewDecisionType
        -level: ApprovalLevel
        -comments: String
        -decidedAt: Instant
    }

    enum ReviewDecisionType {
        APPROVED
        REJECTED
        ESCALATED
        RETURNED
    }
}

package "audit" <<Rectangle>> {

    class AuditLog {
        -id: Long
        -userId: Long
        -actionType: String
        -entityType: String
        -entityId: Long
        -previous: Map
        -details: Map
        -ipAddress: InetAddress
        -userAgent: String
        -correlationId: UUID
        -createdAt: Instant
    }
}

package "заплановано (лише таблиці)" <<Rectangle>> {

    class Document <<planned епік 3>> {
        -awardId: Long
        -requestId: Long
        -fileName: String
        -fileType: String
        -storageBucket: String
        -storageKey: String
        -parsedMetadata: JSON
        -confidenceScore: BigDecimal
        -processingStatus: String
        -uploadedBy: Long
    }

    class ConsentRecord <<planned епік 6>> {
        -userId: Long
        -consentType: String
        -consentVersion: String
        -granted: boolean
    }

    class Notification <<planned епік 7>> {
        -userId: Long
        -type: String
        -channel: String
        -read: boolean
    }
}

' Зв'язки
User "*" --> "1" Organization : належить до
User --> AccountStatus
User "1" <-- "*" UserRole : має
UserRole --> RoleType
UserRole "*" --> "1" Organization : в області
Organization "0..1" <-- "*" Organization : батьківська
Organization --> OrganizationType
RoleDelegation "*" --> "2" User : делегант, делегат
RoleDelegation "*" --> "1" Organization : в області
RoleDelegation --> DelegationState

Award "*" --> "1" User : власник
Award "*" --> "1" Organization : подано в
Award "*" --> "0..1" AwardCategory : категорія
Award --> AwardStatus
AwardCategory --> RecognitionLevel
AwardCategory "0..1" <-- "*" AwardCategory : батьківська
RecognitionLevel --> ApprovalLevel : мінімальне затвердження
Award "1" <-- "*" AwardVersion : версії
AwardVersion --> VersionAction
AwardVersion *-- AwardSnapshot
Award "1" <-- "0..1" AwardRequest : запит
AwardRequest --> RequestStatus
AwardRequest --> ApprovalLevel : поточний рівень
AwardRequest "1" <-- "*" ReviewDecision : рішення
ReviewDecision --> ReviewDecisionType
ReviewDecision "*" --> "1" User : рецензент

Document ..> Award
ConsentRecord ..> User
Notification ..> User

@enduml
