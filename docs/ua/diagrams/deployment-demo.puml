@startuml Deployment_Demo_UA
' =============================================================================
' Демонстраційне розгортання для захисту дипломної роботи (ADR-021, доповнення 2026-11-11)
' Система Моніторингу та Відстеження Нагород
' =============================================================================

!theme plain

skinparam node {
    BackgroundColor<<cloud>> LightBlue
    BackgroundColor<<container>> LightGreen
    BackgroundColor<<database>> LightYellow
    BackgroundColor<<external>> Pink
    BackgroundColor<<security>> LightCoral
}

title Демонстраційне середовище - Діаграма розгортання (AWS, один хост EC2, Docker Compose)

cloud "Інтернет" as internet {
    actor "Користувачі" as users
}

node "AWS eu-central-1" <<cloud>> as region {
    node "VPC за замовчуванням, публічна підмережа" as vpc {
        component [Elastic IP\n<ip>.sslip.io] as eip
        node "Група безпеки\n80, 443 з будь-якого місця; 22 лише для входу за ключем" <<security>> as sg {
            node "EC2 m7i-flex.large (2 vCPU, 8 ГБ)\nUbuntu 24.04, Docker Engine, swap 2 ГБ" as host {
                component [Caddy\nTLS, Let's Encrypt\n:80 :443] <<security>> as caddy

                node "Мережа Compose (без опублікованих портів; журнали json-file 10 МБ x 5, mem_limit для кожного сервісу)" <<container>> as net {
                    component [frontend\nnginx + Angular\n64 МБ] as frontend
                    component [app\nSpring Boot, профіль production\nсервер авторизації + API\n1 ГБ, фіксована адреса] as app
                    database "PostgreSQL 17\n256 МБ" <<database>> as postgres
                    database "Redis 7 (пароль)\n64 МБ" <<database>> as redis
                    database "MinIO (SSE-S3)\n512 МБ" <<database>> as minio
                    component [ClamAV clamd\n+ freshclam\n2,9 ГБ] as clamav
                    component [backup\ncron, pg_dump + age, rclone\n1,1 ГБ, з tmpfs 768 МБ] as backup
                }
            }
        }
        storage "EBS gp3 40 ГБ, зашифрований\nтоми Docker" as ebs
    }
}

node "AWS eu-north-1" <<cloud>> as backupRegion {
    database "S3-бакет\naward-backups\nжиттєвий цикл 14 днів" as s3
}

node "GitHub" <<external>> as github {
    component [GitHub Actions\nзбірка, сканування, deploy-demo\n(сканує тег, що розгортається)] as actions
    component [GitHub Container Registry\nобрази main-<sha>] as ghcr
}

node "Зовнішні сервіси" <<external>> as external {
    component [SMTP-ретранслятор Brevo] as smtp
}

users --> eip : HTTPS (443)
eip --> caddy
caddy --> frontend : HTTP (80)
frontend --> app : /api, /oauth2, /login (8080)
app --> postgres : JDBC (5432)
app --> redis : RESP (6379)
app --> minio : S3 API (9000)
app --> clamav : INSTREAM (3310)
app --> smtp : SMTP + STARTTLS (587)
postgres --> ebs
minio --> ebs
backup --> postgres : pg_dump
backup --> minio : дзеркало
backup ..> s3 : щоночі зашифрований архів (IAM-користувач лише з правом запису)
actions --> ghcr : завантаження образів
actions ..> host : SSH (закріплений ключ хоста):\nкопіювання файлів Compose, .env.release,\npull, up -d --wait, димовий тест
host ..> ghcr : docker compose pull

note right of net
    Секрети — лише з .env.prod на сервері;
    теги образів з .env.release (deploy-demo).
    Демонстраційні облікові записи (@demo.example)
    створюються лише із заданим DEMO_PASSWORD_HASH.
end note

@enduml
