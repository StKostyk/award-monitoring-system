@startuml ERD_Database_Schema
!theme plain
skinparam linetype ortho

title Award Monitoring & Tracking System - Entity Relationship Diagram (as built, V035)

' * mandatory (NOT NULL); all timestamps are TIMESTAMPTZ

package "Identity" {
entity "users" as users {
    * user_id : BIGINT <<PK>>
    --
    * email_address : VARCHAR(255) <<UK lower>>
    * first_name : VARCHAR(100)
    * last_name : VARCHAR(100)
    * password_hash : VARCHAR(255)
    * account_status : VARCHAR(20)
    * organization_id : BIGINT <<FK>>
    last_login_at : TIMESTAMPTZ
    * created_at : TIMESTAMPTZ
    * updated_at : TIMESTAMPTZ
    * version : BIGINT
}

entity "organizations" as organizations {
    * org_id : BIGINT <<PK>>
    --
    * name : VARCHAR(255)
    name_uk : VARCHAR(255)
    code : VARCHAR(50)
    * org_type : VARCHAR(20)
    parent_org_id : BIGINT <<FK>>
    hierarchy_path : LTREE
    * depth : INTEGER
    review_working_days : INTEGER
    * is_active : BOOLEAN
    * created_at : TIMESTAMPTZ
    * updated_at : TIMESTAMPTZ
}

entity "user_roles" as user_roles {
    * user_role_id : BIGINT <<PK>>
    --
    * user_id : BIGINT <<FK>>
    * organization_id : BIGINT <<FK>>
    * role_type : VARCHAR(30)
    * valid_from : DATE
    valid_to : DATE
    * created_at : TIMESTAMPTZ
    created_by : BIGINT <<FK>>
}

entity "role_delegations" as delegations {
    * delegation_id : BIGINT <<PK>>
    --
    * delegator_id : BIGINT <<FK>>
    * delegate_id : BIGINT <<FK>>
    * organization_id : BIGINT <<FK>>
    * role_type : VARCHAR(30)
    reason : VARCHAR(500)
    * valid_from : DATE
    * valid_to : DATE
    * created_at : TIMESTAMPTZ
    revoked_at : TIMESTAMPTZ
    revoked_by : BIGINT <<FK>>
}

entity "one_time_tokens" as tokens {
    * id : BIGINT <<PK>>
    --
    * token_hash : VARCHAR(64) <<UK>>
    * user_id : BIGINT <<FK>>
    * purpose : VARCHAR(30)
    new_email_address : VARCHAR(255)
    * expires_at : TIMESTAMPTZ
    used_at : TIMESTAMPTZ
    * created_at : TIMESTAMPTZ
}

entity "user_devices" as devices {
    * id : BIGINT <<PK>>
    --
    * user_id : BIGINT <<FK>>
    * fingerprint : VARCHAR(64)
    browser : VARCHAR(100)
    operating_system : VARCHAR(100)
    last_ip_address : VARCHAR(45)
    * first_seen_at : TIMESTAMPTZ
    * last_used_at : TIMESTAMPTZ
}
}

package "Award" {
entity "awards" as awards {
    * award_id : BIGINT <<PK>>
    --
    * user_id : BIGINT <<FK>>
    * organization_id : BIGINT <<FK>>
    recipient_org_id : BIGINT <<FK>>
    category_id : BIGINT <<FK>>
    title : VARCHAR(500)
    title_uk : VARCHAR(500)
    description : TEXT
    description_uk : TEXT
    awarding_organization : VARCHAR(255)
    award_date : DATE
    external_url : VARCHAR(2048)
    * status : VARCHAR(20)
    * verification_badge : BOOLEAN
    * visibility : VARCHAR(20)
    impact_score : INTEGER
    * created_at : TIMESTAMPTZ
    * updated_at : TIMESTAMPTZ
    * version : BIGINT
}

entity "award_categories" as categories {
    * category_id : BIGINT <<PK>>
    --
    * name : VARCHAR(100) <<UK>>
    name_uk : VARCHAR(100)
    description : TEXT
    * level : VARCHAR(20)
    parent_category_id : BIGINT <<FK>>
    * keywords : TEXT[]
    * sort_order : INTEGER
    * is_active : BOOLEAN
    * is_system : BOOLEAN
    * created_at : TIMESTAMPTZ
    * updated_at : TIMESTAMPTZ
}

entity "award_versions" as versions {
    * version_id : BIGINT <<PK>>
    --
    * award_id : BIGINT <<FK>>
    * version_number : BIGINT
    * action : VARCHAR(20)
    actor_id : BIGINT <<FK>>
    * snapshot : JSONB
    changed_fields : TEXT[]
    comment : TEXT
    * created_at : TIMESTAMPTZ
}

entity "documents" as documents {
    * document_id : BIGINT <<PK>>
    --
    award_id : BIGINT <<FK>>
    request_id : BIGINT <<FK>>
    * file_name : VARCHAR(255)
    * file_type : VARCHAR(50)
    mime_type : VARCHAR(100)
    * file_size : BIGINT
    * storage_bucket : VARCHAR(100)
    * storage_key : VARCHAR(500)
    storage_url : VARCHAR(2048)
    checksum_sha256 : VARCHAR(64)
    * document_type : VARCHAR(30)
    description : VARCHAR(500)
    parsed_metadata : JSONB
    confidence_score : NUMERIC(5,4)
    * processing_status : VARCHAR(20)
    processed_at : TIMESTAMPTZ
    * uploaded_at : TIMESTAMPTZ
    * uploaded_by : BIGINT <<FK>>
}
}

package "Workflow" {
entity "award_requests" as requests {
    * request_id : BIGINT <<PK>>
    --
    * award_id : BIGINT <<FK>> <<UK>>
    * submitter_id : BIGINT <<FK>>
    current_reviewer_id : BIGINT <<FK>>
    * status : VARCHAR(20)
    * current_level : VARCHAR(30)
    * submitted_at : TIMESTAMPTZ
    deadline : TIMESTAMPTZ
    completed_at : TIMESTAMPTZ
    rejection_reason : TEXT
    overdue_noticed_at : TIMESTAMPTZ
    overdue_noticed_level : VARCHAR(30)
    * created_at : TIMESTAMPTZ
    * updated_at : TIMESTAMPTZ
    * version : BIGINT
}

entity "review_decisions" as decisions {
    * decision_id : BIGINT <<PK>>
    --
    * request_id : BIGINT <<FK>>
    * reviewer_id : BIGINT <<FK>>
    * decision : VARCHAR(20)
    * level : VARCHAR(30)
    comments : TEXT
    delegator_id : BIGINT <<FK>>
    * decided_at : TIMESTAMPTZ
}

entity "review_templates" as templates {
    * template_id : BIGINT <<PK>>
    --
    * decision : VARCHAR(10)
    * title_uk : VARCHAR(120)
    title_en : VARCHAR(120)
    * body_uk : VARCHAR(2000)
    body_en : VARCHAR(2000)
    * sort_order : INTEGER
    * active : BOOLEAN
    * created_at : TIMESTAMPTZ
    * updated_at : TIMESTAMPTZ
}
}

package "Compliance" {
entity "audit_logs" as audit_logs {
    * log_id : BIGINT <<PK>>
    --
    user_id : BIGINT
    * action_type : VARCHAR(50)
    * entity_type : VARCHAR(50)
    entity_id : BIGINT
    old_values : JSONB
    new_values : JSONB
    changed_fields : TEXT[]
    ip_address : INET
    user_agent : VARCHAR(500)
    correlation_id : UUID
    * created_at : TIMESTAMPTZ <<partition key>>
}

entity "consent_records" as consent_records {
    * consent_id : BIGINT <<PK>>
    --
    * user_id : BIGINT <<FK>>
    * consent_type : VARCHAR(50)
    * consent_version : VARCHAR(20)
    * is_granted : BOOLEAN
    granted_at : TIMESTAMPTZ
    withdrawn_at : TIMESTAMPTZ
    ip_address : INET
    user_agent : VARCHAR(500)
    * created_at : TIMESTAMPTZ
}
}

package "Notification" {
entity "notifications" as notifications {
    * notification_id : BIGINT <<PK>>
    --
    * user_id : BIGINT <<FK>>
    * type : VARCHAR(50)
    * title : VARCHAR(255)
    * message : TEXT
    * is_read : BOOLEAN
    * channel : VARCHAR(20)
    reference_type : VARCHAR(50)
    reference_id : BIGINT
    * sent_at : TIMESTAMPTZ
    read_at : TIMESTAMPTZ
    expires_at : TIMESTAMPTZ
}

entity "notification_preferences" as notif_prefs {
    * preference_id : BIGINT <<PK>>
    --
    * user_id : BIGINT <<FK>>
    * event_type : VARCHAR(50)
    * email_enabled : BOOLEAN
    * sms_enabled : BOOLEAN
    * in_app_enabled : BOOLEAN
    * push_enabled : BOOLEAN
    * created_at : TIMESTAMPTZ
    * updated_at : TIMESTAMPTZ
}
}

' Relationships
users }o--|| organizations : "belongs to"
organizations |o--o{ organizations : "parent"
users ||--o{ user_roles : "holds"
user_roles }o--|| organizations : "scoped to"
users ||--o{ delegations : "delegates / receives"
delegations }o--|| organizations : "scoped to"
users ||--o{ tokens : "has"
users ||--o{ devices : "signs in from"

users ||--o{ awards : "owns"
awards }o--|| organizations : "submitted in"
awards }o--o| organizations : "received by"
awards }o--o| categories : "categorised by"
categories |o--o{ categories : "parent"
awards ||--o{ versions : "versioned by"
users |o--o{ versions : "acts"
awards |o--o{ documents : "has"
users ||--o{ documents : "uploads"

awards ||--o| requests : "submitted as"
users ||--o{ requests : "submits"
users |o--o{ requests : "reviews"
requests ||--o{ decisions : "has"
users ||--o{ decisions : "decides"
users |o--o{ decisions : "delegates"
requests |o--o{ documents : "has"

users ||--o{ consent_records : "gives"
users ||--o{ notifications : "receives"
users ||--o{ notif_prefs : "sets"

note bottom of audit_logs
    Partitioned by month on created_at;
    user_id has no foreign key, so rows
    survive the deletion of the user.
end note

note bottom of versions
    Actions include DECIDED (V029) and CORRECTED (V034).
    Unique (award_id, version_number);
    rows are immutable and deleted
    with the award (V023).
end note

note right of awards
    title, category_id, awarding_organization
    and award_date may be empty only
    while status = DRAFT (V020).
    Indexes: DATA_DICTIONARY.md 2.1
end note

note bottom of documents
    Metadata only; the file is an object in MinIO.
    Unique (award_id, checksum_sha256);
    document_type and description since V025.
end note

note right of requests
    deadline: end of the review period of
    the current level (V024); overdue_noticed_*
    mark the notice sent for a level (V033).
    Indexes: DATA_DICTIONARY.md 3.1
end note

@enduml
