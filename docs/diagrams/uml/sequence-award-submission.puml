@startuml Sequence_Award_Submission
!theme plain
skinparam sequenceMessageAlign center

title Award Submission Sequence Diagram (as built after Epic 2)

actor "Owner\n(award:create)" as owner
participant "Angular app" as webapp
participant "nginx" as proxy
participant "AwardController" as ctrl
participant "AwardService /\nAwardSubmission" as svc
participant "AwardInputRules /\nDuplicateFinder" as rules
participant "AwardHistory" as history
participant "AuditService" as audit
database "PostgreSQL" as db

note over webapp, ctrl
    Every call carries the bearer access token (authorization code + PKCE);
    the resource server validates it and @access.require checks the permission.
end note

== Draft creation and editing ==
owner -> webapp: Fill the award form
webapp -> proxy: POST /api/v1/awards
proxy -> ctrl: forward
ctrl -> svc: create(form)
svc -> rules: field rules (dates, URL, active category)
svc -> db: INSERT awards (status DRAFT, organization of the owner)
svc -> history: created(award)
history -> db: INSERT award_versions (CREATED, snapshot)
svc --> webapp: 201 AwardResponse (id, version)

opt Category suggestion while typing
    webapp -> proxy: GET /api/v1/award-categories/suggestions?title=...
    proxy -> ctrl: forward
    ctrl --> webapp: 200 ranked categories (keyword match)
end

owner -> webapp: Edit the draft
webapp -> proxy: PUT /api/v1/awards/{id} (form + version)
proxy -> ctrl: forward
ctrl -> svc: update(id, form)
svc -> db: UPDATE awards (optimistic lock on version)
svc -> history: updated(award)
history -> db: INSERT award_versions (UPDATED, changed fields)
svc --> webapp: 200 AwardResponse

== Submission ==
owner -> webapp: Submit
webapp -> proxy: POST /api/v1/awards/{id}/submit {version, acknowledgeDuplicate}
proxy -> ctrl: forward
ctrl -> svc: submit(id, request)
svc -> db: SELECT ... FOR UPDATE (own draft)
alt not an own draft
    svc --> webapp: 404 (foreign) / 409 award-not-editable (already submitted)
else stale version
    svc --> webapp: 409 award-stale {currentVersion}
end
svc -> rules: checkComplete (category, awarding organisation, award date)
alt incomplete
    svc --> webapp: 422 validation-failed
end
svc -> rules: duplicate matches (same date, title similarity >= 0.6)
alt matches and not acknowledged
    svc --> webapp: 409 award-possible-duplicate {matches}
    webapp --> owner: Show the similar awards, ask to confirm
end
svc -> db: UPDATE awards SET status PENDING, impact_score = level base score,\norganization = owner's department
svc -> history: submitted(award)
history -> db: INSERT award_versions (SUBMITTED)
svc -> db: INSERT award_requests (SUBMITTED, FACULTY_SECRETARY,\ndeadline from StatusEstimator)
svc -> audit: AWARD_SUBMITTED {requestId, level, organizationId, duplicateAcknowledged?}
audit -> db: INSERT audit_logs
svc --> webapp: 200 AwardResponse with request
webapp --> owner: "Submitted for review"

== Status tracking ==
loop every 60 s while the award page is open and the request is not final
    webapp -> proxy: GET /api/v1/awards/{id}/status
    proxy -> ctrl: forward
    ctrl --> webapp: 200 approval path, deadline, expected completion, decisions
end

note over owner, db
    Planned: certificate upload and OCR (Epic 3), reviewer decisions (Epic 4),
    notifications to reviewers (Epic 7).
end note

@enduml
