@startuml Package_Diagram
!theme plain
skinparam package {
    BackgroundColor<<domain>> LightGreen
    BackgroundColor<<security>> LightBlue
    BackgroundColor<<shared>> LightYellow
    BackgroundColor<<config>> LightGray
}

title Award Monitoring & Tracking System - Package Diagram (Java backend, Spring Modulith modules after Epic 7)

' Package by domain: each top-level package is an application module (ADR-022); others use only its base
' package and its named interfaces (dto, event, entity, service), never its repository, controller or mapper

package "ua.edu.chnu.awards" {

    package "auth" <<security>> {
        package "web" as auth_web {
            class AuthController
            class LoginController
            class EmailChangeController
        }
        package "config" as auth_config {
            class SecurityConfig
            class AuthorizationServerConfig
            class LoginSessionConfig
            class TokenConfig
            class AuthProperties
        }
        package "security" as auth_security {
            class RateLimitFilter
            class JwtAuthorityConverter
            class RefreshTokenReuseGuard
            class LoginAttemptService
        }
        package "service" as auth_service {
            class RegistrationService
            class PasswordResetService
            class EmailChangeService
            class DeviceService
            class DeviceLookup
        }
        package "entity" as auth_entity {
            class OneTimeToken
            class UserDevice
        }
    }

    package "authz" <<security>> {
        class AccessScope
        class RoleType
        class RolePermissions
        class TokenClaimConstants
        class RoleScope
        class DelegatedScope
        class AccessDenials
        class AccessDeniedProblems
    }

    package "organization" <<domain>> {
        class OrganizationTree
        class OrganizationController
        class OrganizationService
        class OrganizationLookup
        class Organization
    }

    package "user" <<domain>> {
        interface AccountSessions
        interface LentAuthority
        package "controller" as user_controller {
            class UserController
            class UserProfileController
        }
        package "service" as user_service {
            class UserDirectoryService
            class UserProfileService
            class RoleAssignmentService
            class UserAccounts
            class RoleHolders
            class UserActorDirectory
        }
        package "entity" as user_entity {
            class User
            class UserRole
        }
    }

    package "delegation" <<domain>> {
        class DelegationController
        class DelegationService
        class DelegationLookup
        class RoleDelegation
    }

    package "award" <<domain>> {
        interface AwardDocuments
        package "controller" as award_controller {
            class AwardController
            class AwardCategoryController
            class AwardHistoryController
            class ReviewController
            class ReviewBatchController
            class CorrectionController
            class WithdrawalController
            class SharingController
            class AchievementController
            class PublicAchievementController
            class ReviewPeriodController
            class RecipientUnitController
        }
        package "service" as award_service {
            class AwardService
            class AwardSubmission
            class AwardOwnership
            class AwardInputRules
            class DuplicateFinder
            class CategorySuggester
            class AwardHistory
            class AwardStatusService
            class StatusEstimator
            class Transitions
            class ReviewerRule
            class ReviewQueue
            class ReviewAssignment
            class ReviewDecisions
            class BatchReview
            class AwardWithdrawal
            class AwardCorrection
            class ReviewPeriods
            class OverdueJob
            class OverdueNotices
            class AwardSharing
            class Achievements
            class AwardLookup
            class AwardLinks
        }
        package "entity" as award_entity {
            class Award
            class AwardCategory
            class AwardRequest
            class ReviewDecision
            class ReviewTemplate
            class AwardVersion
        }
        package "repository" as award_repository {
            class AwardRepository
            class AwardSpecifications
            class CategorySuggestionQueries
        }
        package "mapper" as award_mapper {
            class AwardMapper
        }
    }

    package "document" <<domain>> {
        package "controller" as document_controller {
            class DocumentController
        }
        package "service" as document_service {
            class DocumentService
            class DocumentUpload
            class UploadLimits
            class MalwareScreening
            class ClamAvScanner
            class ObjectStorage
            class StoredObjectCleanup
            class DocumentSweeper
            class DocumentsOfAwards
        }
        package "config" as document_config {
            class StorageConfig
        }
        package "entity" as document_entity {
            class Document
        }
        package "repository" as document_repository {
            class DocumentRepository
        }
    }

    package "gdpr" <<domain>> {
        class DataExportController
        class DataExportService
        class PersonalDataAssembler
    }

    package "notification" <<domain>> {
        class AuthorityChangeMails
        class DecisionMails
        class CorrectionMails
        class OverdueMails
        class TakeOverMails
        package "controller" as notification_controller {
            class NotificationController
            class NotificationPreferenceController
        }
        package "service" as notification_service {
            class InAppNotifications
            class NotificationService
            class NotificationPreferenceService
            class NotificationDrafts
            class DeliveryLog
            class DeliveryMetrics
            class NotificationLookup
        }
        package "entity" as notification_entity {
            class Notification
            class NotificationPreference
        }
        package "repository" as notification_repository {
            class NotificationRepository
            class NotificationPreferenceRepository
        }
    }

    package "metrics" <<config>> {
        class MetricsConfiguration
        class ObservabilityConfiguration
    }

    package "audit" <<shared>> {
        interface ActorDirectory
        class AuditService
        class AuditTrailService
        class AuditLog
    }

    package "common" <<shared>> {
        package "web" as common_web {
            class ApiExceptionHandler
            class ApiProblemException
            class NotFoundException
            class CorrelationIdFilter
            class PageResponse
        }
        package "mail" as common_mail {
            class MailDelivery
            class MailHtmlRenderer
            class UndeliveredMailAsyncHandler
        }
        package "event" as common_event {
            class AfterCommit
            class PublicationRetry
        }
        package "limit" as common_limit {
            class FixedWindowCounter
        }
    }

    package "config" <<config>> {
        class OpenApiConfig
        class InfrastructureConfig
        class TransactionConfig
        class WebLocaleConfig
    }
}

' Dependencies between modules (verified by ModularityTest; no cycle)
user ..> organization
user ..> authz
authz ..> organization
authz ..> audit
delegation ..> user : implements LentAuthority
delegation ..> organization
delegation ..> authz
auth ..> user : implements AccountSessions
auth ..> delegation
auth ..> organization
auth ..> authz
award ..> user : owner, reviewers
award ..> organization
award ..> authz : readable scope
award ..> delegation : delegated review scopes
award ..> audit : AWARD_* and REVIEW_* rows
document ..> award : implements AwardDocuments
document ..> user
document ..> authz
document ..> audit : DOCUMENT_* rows
gdpr ..> award
gdpr ..> auth : devices
gdpr ..> delegation
gdpr ..> user
gdpr ..> notification : NotificationLookup
notification ..> user : role events, recipients
notification ..> delegation : delegation events
notification ..> award : decision, correction, overdue, takeover events
notification ..> authz
notification ..> audit : NOTIFICATION_PREFERENCES_CHANGED
user ..> audit : implements ActorDirectory
config ..> audit

note bottom of award
    Mappers are hand-written @Component classes;
    no MapStruct. The review workflow lives in award (ADR-023).
    Listeners of notification run after commit on the
    event publication registry (common.event, ADR-006 addendum).
    common is an open module used by all; config is used by none.
    Planned domains: parsing (OCR, deferred), analytics (Epic 5),
    compliance (Epic 6).
end note

@enduml
