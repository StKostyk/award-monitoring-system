@startuml Class_Diagram_Domain
!theme plain
skinparam classAttributeIconSize 0
skinparam linetype ortho

title Award Monitoring & Tracking System - Domain Class Diagram (as built after Epic 3)

' JPA entities of ua.edu.chnu.awards; classes marked <<planned>> exist as tables only

package "user" <<Rectangle>> {

    class User {
        -id: Long
        -emailAddress: String
        -firstName: String
        -lastName: String
        -passwordHash: String
        -accountStatus: AccountStatus
        -organization: Organization
        -lastLoginAt: Instant
        -createdAt: Instant
        -updatedAt: Instant
        -version: Long
        +isActive(): boolean
    }

    enum AccountStatus {
        PENDING
        ACTIVE
        INACTIVE
        SUSPENDED
        RETIRED
        MEMORIAL
        DELETED
    }

    class UserRole {
        -id: Long
        -user: User
        -roleType: RoleType
        -organization: Organization
        -validFrom: LocalDate
        -validTo: LocalDate
        -createdAt: Instant
        -createdBy: User
        +isCurrentOn(day: LocalDate): boolean
        +hasEndedBy(day: LocalDate): boolean
    }

    enum RoleType {
        EMPLOYEE
        FACULTY_SECRETARY
        DEAN
        RECTOR_SECRETARY
        RECTOR
        SYSTEM_ADMIN
        GDPR_OFFICER
    }

    class Organization {
        -id: Long
        -name: String
        -nameUk: String
        -code: String
        -orgType: OrganizationType
        -parent: Organization
        -depth: int
        -active: boolean
        +enclosingFaculty(): Organization
    }

    enum OrganizationType {
        UNIVERSITY
        COLLEGE
        FACULTY
        SPECIALITY
        DEPARTMENT
    }
}

package "delegation" <<Rectangle>> {

    class RoleDelegation {
        -id: Long
        -delegator: User
        -delegate: User
        -roleType: RoleType
        -organization: Organization
        -validFrom: LocalDate
        -validTo: LocalDate
        -reason: String
        -revokedAt: Instant
        -revokedBy: User
        +stateOn(day: LocalDate): DelegationState
        +isCurrentOn(day: LocalDate): boolean
    }

    enum DelegationState {
        ACTIVE
        UPCOMING
        EXPIRED
        REVOKED
    }
}

package "award" <<Rectangle>> {

    class Award {
        -id: Long
        -owner: User
        -organization: Organization
        -category: AwardCategory
        -title: String
        -titleUk: String
        -description: String
        -descriptionUk: String
        -awardingOrganization: String
        -awardDate: LocalDate
        -status: AwardStatus
        -verificationBadge: boolean
        -impactScore: Integer
        -externalUrl: String
        -createdAt: Instant
        -updatedAt: Instant
        -version: Long
        +isDraft(): boolean
    }

    enum AwardStatus {
        DRAFT
        PENDING
        APPROVED
        REJECTED
        ARCHIVED
    }

    class AwardCategory {
        -id: Long
        -name: String
        -nameUk: String
        -description: String
        -level: RecognitionLevel
        -parent: AwardCategory
        -sortOrder: int
        -active: boolean
        -system: boolean
    }

    enum RecognitionLevel {
        SPECIALITY (FACULTY_SECRETARY, 10)
        DEPARTMENT (FACULTY_SECRETARY, 20)
        COLLEGE (FACULTY_SECRETARY, 30)
        FACULTY (FACULTY_SECRETARY, 40)
        UNIVERSITY (FACULTY_SECRETARY, 50)
        LOCAL (FACULTY_SECRETARY, 60)
        REGIONAL (FACULTY_SECRETARY, 70)
        NATIONAL (RECTOR_SECRETARY, 80)
        INTERNATIONAL (RECTOR_SECRETARY, 100)
        --
        +minimumApproval(): ApprovalLevel
        +baseScore(): int
    }

    class AwardVersion <<immutable>> {
        -id: Long
        -awardId: Long
        -number: long
        -action: VersionAction
        -actor: User
        -snapshot: AwardSnapshot
        -changedFields: String[]
        -createdAt: Instant
    }

    enum VersionAction {
        BASELINE
        CREATED
        UPDATED
        SUBMITTED
    }

    class AwardSnapshot <<record>> {
        title, titleUk, description, descriptionUk
        awardingOrganization, awardDate, categoryId
        status, impactScore, verificationBadge
        externalUrl, organizationId
    }

    class AwardRequest {
        -id: Long
        -award: Award
        -submitter: User
        -status: RequestStatus
        -currentLevel: ApprovalLevel
        -submittedAt: Instant
        -deadline: Instant
        -completedAt: Instant
        -rejectionReason: String
    }

    enum RequestStatus {
        SUBMITTED
        IN_REVIEW
        ESCALATED
        APPROVED
        REJECTED
        RETURNED
        EXPIRED
    }

    enum ApprovalLevel {
        FACULTY_SECRETARY
        DEAN
        RECTOR_SECRETARY
        RECTOR
    }

    class ReviewDecision <<immutable>> {
        -id: Long
        -requestId: Long
        -reviewer: User
        -decision: ReviewDecisionType
        -level: ApprovalLevel
        -comments: String
        -decidedAt: Instant
    }

    enum ReviewDecisionType {
        APPROVED
        REJECTED
        ESCALATED
        RETURNED
    }
}

package "document" <<Rectangle>> {

    class Document {
        -id: Long
        -award: Award
        -fileName: String
        -format: DocumentFormat
        -mimeType: String
        -size: long
        -storageBucket: String
        -storageKey: String
        -checksum: String
        -type: DocumentType
        -description: String
        -uploadedAt: Instant
        -uploadedBy: User
    }

    enum DocumentFormat {
        PDF
        JPEG
        PNG
        WEBP
    }

    enum DocumentType {
        CERTIFICATE
        DIPLOMA
        SUPPORTING_DOCUMENT
        PHOTO
    }

    note bottom of Document
        Metadata only; the file is an object in MinIO
        (awards/<award>/<UUID>). Not mapped yet:
        request_id (Epic 4), parsing columns (OCR, deferred).
    end note
}

package "audit" <<Rectangle>> {

    class AuditLog {
        -id: Long
        -userId: Long
        -actionType: String
        -entityType: String
        -entityId: Long
        -previous: Map
        -details: Map
        -ipAddress: InetAddress
        -userAgent: String
        -correlationId: UUID
        -createdAt: Instant
    }
}

package "planned (tables only)" <<Rectangle>> {

    class ConsentRecord <<planned Epic 6>> {
        -userId: Long
        -consentType: String
        -consentVersion: String
        -granted: boolean
    }

    class Notification <<planned Epic 7>> {
        -userId: Long
        -type: String
        -channel: String
        -read: boolean
    }
}

' Relationships
User "*" --> "1" Organization : belongs to
User --> AccountStatus
User "1" <-- "*" UserRole : held by
UserRole --> RoleType
UserRole "*" --> "1" Organization : scoped to
Organization "0..1" <-- "*" Organization : parent
Organization --> OrganizationType
RoleDelegation "*" --> "2" User : delegator, delegate
RoleDelegation "*" --> "1" Organization : scoped to
RoleDelegation --> DelegationState

Award "*" --> "1" User : owner
Award "*" --> "1" Organization : submitted in
Award "*" --> "0..1" AwardCategory : categorised by
Award --> AwardStatus
AwardCategory --> RecognitionLevel
AwardCategory "0..1" <-- "*" AwardCategory : parent
RecognitionLevel --> ApprovalLevel : minimum approval
Award "1" <-- "*" AwardVersion : versions
AwardVersion --> VersionAction
AwardVersion *-- AwardSnapshot
Award "1" <-- "0..1" AwardRequest : request
AwardRequest --> RequestStatus
AwardRequest --> ApprovalLevel : current level
AwardRequest "1" <-- "*" ReviewDecision : decisions
ReviewDecision --> ReviewDecisionType
ReviewDecision "*" --> "1" User : reviewer

Award "1" <-- "*" Document : evidence
Document "*" --> "1" User : uploaded by
Document --> DocumentFormat
Document --> DocumentType
ConsentRecord ..> User
Notification ..> User

@enduml
