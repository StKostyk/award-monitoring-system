    {
      "name": "Awards",
      "description": "Own drafts and awards in scope (award:create, award:update:own, award:read:*).",
      "item": [
        {
          "name": "List awards",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/awards?page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "awards"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0",
                  "disabled": false
                },
                {
                  "key": "size",
                  "value": "20",
                  "disabled": false
                },
                {
                  "key": "status",
                  "value": "DRAFT",
                  "disabled": true
                },
                {
                  "key": "category",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "dateFrom",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "dateTo",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": "Own awards and awards in scope, newest first."
          }
        },
        {
          "name": "Create draft",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/awards",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "awards"
              ]
            },
            "description": "Only a title is needed for a draft.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Best Paper Award\",\n  \"titleUk\": \"Найкраща стаття\",\n  \"description\": \"Best paper of the conference track\",\n  \"categoryId\": {{categoryId}},\n  \"awardingOrganization\": \"IEEE\",\n  \"awardDate\": \"2026-06-15\",\n  \"externalUrl\": \"https://example.org/awards/2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const award = pm.response.json();",
                  "    pm.collectionVariables.set('awardId', award.id);",
                  "    pm.collectionVariables.set('awardVersion', award.version);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get award",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/awards/{{awardId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "awards",
                "{{awardId}}"
              ]
            },
            "description": "404 when the award is not readable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const award = pm.response.json();",
                  "    pm.collectionVariables.set('awardId', award.id);",
                  "    pm.collectionVariables.set('awardVersion', award.version);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update draft",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/awards/{{awardId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "awards",
                "{{awardId}}"
              ]
            },
            "description": "Full replacement; `version` is the one last read (409 award-stale otherwise).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Best Paper Award\",\n  \"titleUk\": \"Найкраща стаття\",\n  \"description\": \"Best paper of the conference track\",\n  \"categoryId\": {{categoryId}},\n  \"awardingOrganization\": \"IEEE\",\n  \"awardDate\": \"2026-06-15\",\n  \"externalUrl\": \"https://example.org/awards/2026\",\n  \"version\": {{awardVersion}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const award = pm.response.json();",
                  "    pm.collectionVariables.set('awardId', award.id);",
                  "    pm.collectionVariables.set('awardVersion', award.version);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit draft",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/awards/{{awardId}}/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "awards",
                "{{awardId}}",
                "submit"
              ]
            },
            "description": "409 award-possible-duplicate lists similar awards; repeat with acknowledgeDuplicate true.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": {{awardVersion}},\n  \"acknowledgeDuplicate\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
