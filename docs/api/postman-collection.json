{
  "info": {
    "_postman_id": "award-monitoring-api-v1",
    "name": "Award Monitoring & Tracking System API",
    "description": "Requests for the implemented endpoints of the Award Monitoring System (Epics 1 and 2). The contract is docs/api/openapi.yml; planned endpoints (approval, documents, reports) are not included.\n\n## Authentication\nThe application is its own OAuth 2.1 provider. The collection uses Postman's OAuth 2.0 helper with the authorization code flow and PKCE for the public client `award-web`:\n1. Open the collection, tab Authorization, and click *Get New Access Token*.\n2. Sign in with a seed account (for example `employee.fmi@chnu.edu.ua`) in the Postman window.\n3. Click *Use Token*. Access tokens live 15 minutes; request a new one when it expires.\n\nThe callback URL `http://localhost:4200/callback` is a registered redirect URI; Postman captures the redirect, so the frontend does not need to run. Leave *Authorize using browser* off.\n\n## Variables\n`baseUrl` (backend, default http://localhost:8080/api/v1), `authBase` (http://localhost:8080), `awardId`, `awardVersion` (saved from award responses), `categoryId`, `userId`, `delegationId`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "oauth2",
    "oauth2": [
      {
        "key": "grant_type",
        "value": "authorization_code_with_pkce",
        "type": "string"
      },
      {
        "key": "authUrl",
        "value": "{{authBase}}/oauth2/authorize",
        "type": "string"
      },
      {
        "key": "accessTokenUrl",
        "value": "{{authBase}}/oauth2/token",
        "type": "string"
      },
      {
        "key": "clientId",
        "value": "award-web",
        "type": "string"
      },
      {
        "key": "redirect_uri",
        "value": "http://localhost:4200/callback",
        "type": "string"
      },
      {
        "key": "scope",
        "value": "openid profile",
        "type": "string"
      },
      {
        "key": "challengeAlgorithm",
        "value": "S256",
        "type": "string"
      },
      {
        "key": "client_authentication",
        "value": "body",
        "type": "string"
      },
      {
        "key": "useBrowser",
        "value": false,
        "type": "boolean"
      },
      {
        "key": "addTokenTo",
        "value": "header",
        "type": "string"
      },
      {
        "key": "tokenName",
        "value": "award-web",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "authBase",
      "value": "http://localhost:8080"
    },
    {
      "key": "awardId",
      "value": ""
    },
    {
      "key": "awardVersion",
      "value": "1"
    },
    {
      "key": "categoryId",
      "value": "1"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "delegationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "description": "Public account endpoints. Sign-in itself is the OAuth 2.0 flow of the collection.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Self-registration with an institutional address; sends a verification link.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new.person@chnu.edu.ua\",\n  \"password\": \"a-long-passphrase\",\n  \"firstName\": \"Олена\",\n  \"lastName\": \"Коваль\",\n  \"organizationId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Verify email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/verify-email",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-email"
              ]
            },
            "description": "Token from the verification email plus the registration password.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<token from the email>\",\n  \"password\": \"a-long-passphrase\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Resend verification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/resend-verification",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "resend-verification"
              ]
            },
            "description": "Answers 202 for every address.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new.person@chnu.edu.ua\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Request password reset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/password-reset/request",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "password-reset",
                "request"
              ]
            },
            "description": "Answers 202 for every address.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"employee.fmi@chnu.edu.ua\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Confirm password reset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/password-reset/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "password-reset",
                "confirm"
              ]
            },
            "description": "Signs the account out everywhere.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<token from the email>\",\n  \"password\": \"another-long-passphrase\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Confirm email change",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/email-change/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "email-change",
                "confirm"
              ]
            },
            "description": "Token from the link sent to the new address.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<token from the email>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Revoke after new device (not me)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/security/revoke",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "security",
                "revoke"
              ]
            },
            "description": "Token from the new-device email; signs the account out everywhere and replaces the password.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<token from the email>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "List organisations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/organizations",
              "host": [
                "{{baseUrl}}"
