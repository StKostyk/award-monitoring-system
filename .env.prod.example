# Copy to .env.prod (never committed) and fill in. See docs/deployment/DEMO_DEPLOYMENT.md.
# Values containing $ (bcrypt hashes) must be in single quotes.

SITE_ADDRESS=localhost
BACKEND_IMAGE=award-backend:prod
FRONTEND_IMAGE=award-frontend:prod

POSTGRES_DB=award_monitoring
POSTGRES_USER=award
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=award
MINIO_ROOT_PASSWORD=
# The backend's own account, limited to the document bucket (created by minio-init)
MINIO_APP_USER=award-app
MINIO_APP_PASSWORD=
# Encryption key of the document objects, <name>:<32 random bytes in base64>: echo "award-key:$(openssl rand -base64 32)"
# Losing it makes the stored objects unreadable; keep a copy in the password manager (backups hold plain content).
MINIO_KMS_SECRET_KEY=

# Backups (DEMO_DEPLOYMENT §4). Public key from age-keygen; the private key never goes to the server.
BACKUP_AGE_RECIPIENT=
BACKUP_CRON=30 4 * * *
# Server: the S3 bucket in eu-north-1, an account that may not delete, the lifecycle rule expires after 14 days
BACKUP_REMOTE=s3:award-backups-x
BACKUP_KEEP_DAYS=0
RCLONE_CONFIG_S3_PROVIDER=AWS
RCLONE_CONFIG_S3_REGION=eu-north-1
RCLONE_CONFIG_S3_ENDPOINT=
RCLONE_CONFIG_S3_ACCESS_KEY_ID=
RCLONE_CONFIG_S3_SECRET_ACCESS_KEY=
# Rehearsal: BACKUP_REMOTE=s3:award-backups, BACKUP_KEEP_DAYS=14, RCLONE_CONFIG_S3_PROVIDER=Minio,
# RCLONE_CONFIG_S3_ENDPOINT=http://minio:9000 and the MinIO root account as the key pair

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=

ALLOWED_EMAIL_DOMAINS=chnu.edu.ua

# University brand of the sign-in and error pages (chnu, neutral); the frontend uses brand/brand.json
APP_BRAND=chnu

JWK_KEY_ID=
JWK_PRIVATE_KEY=
JWK_PUBLIC_KEY=

# Demo accounts (db/seed/demo): add the seed location and a bcrypt hash of the shared password
FLYWAY_LOCATIONS=classpath:db/migration
DEMO_PASSWORD_HASH=''
