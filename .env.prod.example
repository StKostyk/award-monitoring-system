# Copy to .env.prod (never committed) and fill in. See docs/deployment/DEMO_DEPLOYMENT.md.
# Values containing $ (bcrypt hashes) must be in single quotes.

SITE_ADDRESS=localhost
BACKEND_IMAGE=award-backend:prod
FRONTEND_IMAGE=award-frontend:prod

POSTGRES_DB=award_monitoring
POSTGRES_USER=award
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=award
MINIO_ROOT_PASSWORD=

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=

ALLOWED_EMAIL_DOMAINS=chnu.edu.ua

JWK_KEY_ID=
JWK_PRIVATE_KEY=
JWK_PUBLIC_KEY=

# Demo accounts (db/seed/demo): add the seed location and a bcrypt hash of the shared password
FLYWAY_LOCATIONS=classpath:db/migration
DEMO_PASSWORD_HASH=''
